# Discord
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_id_here

# Google AI (Gemini) — required for AI features
GOOGLE_AI_KEY=your_google_ai_api_key_here

# Appwrite — required for all persistent storage
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_appwrite_project_id_here
APPWRITE_API_KEY=your_appwrite_server_api_key_here
APPWRITE_DATABASE_ID=daikonbot

# Optional
NODE_ENV=production
